# Proveedor del modelo de chat: openai (por defecto) | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Embeddings: se calculan en local con Ollama (ollama pull embeddinggemma)
EMBED_MODEL=embeddinggemma
OLLAMA_BASE_URL=http://localhost:11434

# Parámetros de generación y memoria (opcionales)
# TEMPERATURE=0.2
# TOP_P=0.9
# MAX_TOKENS=1024
# MAX_HISTORY_TOKENS=2000

# Para usar un modelo local en lugar de OpenAI:
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma4:e2b
# NUM_CTX=8192
